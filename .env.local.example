# Salin file ini jadi .env.local, lalu isi dari Supabase Dashboard:
# Project Settings > Data API (URL) dan Project Settings > API Keys (anon public).
#
# Prefix NEXT_PUBLIC_ artinya nilainya ikut kebundel ke JavaScript browser alias
# publik. Anon key memang dirancang begitu -- yang ngejaga data tetap RLS.
# Jangan pernah naruh service_role key di sini.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
